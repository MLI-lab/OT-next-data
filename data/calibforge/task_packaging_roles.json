    "grading_scripts": [
      "\nimport acme\n\n# Verify acme is a PEP 420 namespace package (__file__ is None)\nassert acme.__file__ is None, \"acme should be a namespace package with __file__=None\"\nassert hasattr(acme, '__path__'), \"acme should have __path__\"\n\n# Import all subpackages\nfrom acme.core import Engine\nfrom acme.utils import format_message, validate_config\nfrom acme.plugins.auth import Authenticator\nfrom acme.plugins.db import Database\n\n# Verify acme.plugins is also a namespace package\nimport acme.plugins\nassert acme.plugins.__file__ is None, \"acme.plugins should be a namespace package with __file__=None\"\n\n# Verify functionality\nengine = Engine(\"production\")\nassert engine.name == \"production\"\nassert not engine.is_running\nengine.start()\nassert engine.is_running\nengine.stop()\nassert not engine.is_running\n\nauth = Authenticator(\"test-secret\")\nhashed = auth.hash_password(\"password123\")\nassert len(hashed) == 64\ntoken = auth.create_session(\"user123\")\nassert auth.validate_session(token) == \"user123\"\nauth.end_session(token)\nassert auth.validate_session(token) is None\n\ndb = Database(\"testdb\")\nassert db.name == \"testdb\"\nassert not db.is_connected\ndb.connect()\nassert db.is_connected\ndb.create_table(\"users\")\ndb.insert(\"users\", {\"id\": 1, \"name\": \"Alice\"})\ndb.insert(\"users\", {\"id\": 2, \"name\": \"Bob\"})\nassert len(db.select(\"users\")) == 2\ndeleted = db.delete(\"users\", lambda r: r[\"name\"] == \"Bob\")\nassert deleted == 1\ndb.disconnect()\nassert not db.is_connected\n\nmsg = format_message(\"test\")\nassert msg == \"[ACME] test\"\n\nassert validate_config({\"name\": \"test\", \"version\": \"1.0\"})\n\nprint(\"All namespace package tests passed!\")\n"
    ],
